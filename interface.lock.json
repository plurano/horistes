{
  "actions": {},
  "interface_major": 0,
  "interface_minor": 2,
  "workflows": {
    ".github/workflows/licence.yml": {
      "inputs": {
        "root": {
          "default": ".",
          "required": false,
          "type": "string"
        },
        "runner": {
          "default": "ubuntu-26.04",
          "required": false,
          "type": "string"
        }
      },
      "jobs": {
        "reuse": "${{ inputs.root == '.' && 'REUSE lint' || format('REUSE lint ({0})', inputs.root) }}"
      },
      "outputs": [],
      "secrets": {},
      "write_scopes": []
    },
    ".github/workflows/scorecard.yml": {
      "inputs": {
        "outside_hosts": {
          "default": false,
          "required": false,
          "type": "boolean"
        },
        "publish": {
          "default": false,
          "required": false,
          "type": "boolean"
        }
      },
      "jobs": {
        "analysis": "${{ inputs.outside_hosts && 'Analysis' || 'Analysis (not started)' }}",
        "switched_off": "${{ inputs.outside_hosts && 'Analysis (switched on)' || 'Analysis' }}",
        "visibility": "Public repository"
      },
      "outputs": [],
      "secrets": {},
      "write_scopes": [
        "id-token",
        "security-events"
      ]
    }
  }
}
