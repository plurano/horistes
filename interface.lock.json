    "actions/install-gitleaks/action.yml": {
      "inputs": {
        "install-dir": {
          "default": null,
          "required": true
        },
        "sha256": {
          "default": null,
          "required": true
        },
        "version": {
          "default": null,
          "required": true
        }
      },
      "outputs": [
        "path"
      ]
    },
