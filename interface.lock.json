        "sha256": {
          "default": null,
          "required": true
        },
        "timeout-seconds": {
          "default": "120",
          "required": false
        },
        "url": {
          "default": null,
          "required": true
        }
      },
      "outputs": [
        "lib"
      ]
    }
  },
  "interface_major": 0,
  "interface_minor": 2,
