{
  "actions": {},
  "interface_major": 0,
  "interface_minor": 2,
  "workflows": {
    ".github/workflows/licence.yml": {
      "inputs": {
        "root": {
          "default": ".",
          "required": false,
          "type": "string"
        },
        "runner": {
          "default": "ubuntu-26.04",
          "required": false,
          "type": "string"
        }
      },
      "jobs": {
        "reuse": "${{ inputs.root == '.' && 'REUSE lint' || format('REUSE lint ({0})', inputs.root) }}"
      },
      "outputs": [],
      "secrets": {},
      "write_scopes": []
    },
    ".github/workflows/merge-train.yml": {
      "inputs": {
        "accept_states": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "app_client_id": {
          "default": null,
          "required": true,
          "type": "string"
        },
        "dependency_branches": {
          "default": "renovate/ dependabot/",
          "required": false,
          "type": "string"
        },
        "hold_labels": {
          "default": "hold,do-not-merge,planted",
          "required": false,
          "type": "string"
        },
        "merge_method": {
          "default": "SQUASH",
          "required": false,
          "type": "string"
        },
        "min_age_days": {
          "default": "3",
          "required": false,
          "type": "string"
        },
        "person_branches": {
          "default": "release-please--",
          "required": false,
          "type": "string"
        },
        "release_off": {
          "default": "",
          "required": false,
          "type": "string"
        },
        "runner": {
          "default": null,
          "required": true,
          "type": "string"
        },
        "security_labels": {
          "default": "security",
          "required": false,
          "type": "string"
        },
        "switch": {
          "default": "on",
          "required": false,
          "type": "string"
        }
      },
      "jobs": {
        "release": "Release pull request and release",
        "train": "Merge train"
      },
      "outputs": [],
      "secrets": {
        "app_private_key": {
          "required": true
        }
      },
      "write_scopes": []
    },
    ".github/workflows/scorecard.yml": {
      "inputs": {
        "outside_hosts": {
          "default": false,
          "required": false,
          "type": "boolean"
        },
        "publish": {
          "default": false,
          "required": false,
          "type": "boolean"
        }
      },
      "jobs": {
        "analysis": "${{ inputs.outside_hosts && 'Analysis' || 'Analysis (not started)' }}",
        "switched_off": "${{ inputs.outside_hosts && 'Analysis (switched on)' || 'Analysis' }}",
        "visibility": "Public repository"
      },
      "outputs": [],
      "secrets": {},
      "write_scopes": [
        "id-token",
        "security-events"
      ]
    }
  }
}
