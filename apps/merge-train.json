{
  "url": "https://github.com/plurano/horistes/blob/main/docs/adr/0029-a-forge-app-drives-the-merge-train.md",
  "description": "Merge train of the fleet: lands clean pull requests one at a time and updates the next one by merge. No bypass, no webhooks. Installed on the fleet's own accounts.",
  "public": true,
  "hook_attributes": {
    "url": "https://github.com/plurano/horistes",
