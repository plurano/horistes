{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/shared-ci"
  ],
  "enabledManagers": [
    "github-actions",
    "pip-compile",
    "custom.regex"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements/tools\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The licence tool image: release in the comment above, digest in the line.",
      "managerFilePatterns": [
        "/^\\.github/workflows/licence\\.yml$/"
      ],
      "matchStrings": [
        "# release (?<currentValue>\\S+)\\n\\s+uses: docker://(?<depName>docker\\.io/fsfe/reuse)@(?<currentDigest>sha256:[0-9a-f]{64})\\n"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "The image of a `uses: docker://` line belongs to the custom manager above.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "docker"
      ],
      "enabled": false
    }
  ]
}
